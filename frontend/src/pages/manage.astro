---
import Layout from '../layouts/Layout.astro';
import StatusButtons from '../components/StatusButtons.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

let archive: any = { weeks: [] };
try {
  const raw = readFileSync(join(process.cwd(), 'public/data/archive.json'), 'utf-8');
  archive = JSON.parse(raw);
} catch {}

// 全推薦レストランをフラット化（重複除去）
const allRestaurants: any[] = [];
const seenIds = new Set();
for (const week of archive.weeks) {
  for (const r of week.restaurants) {
    if (!seenIds.has(r.place_id)) {
      seenIds.add(r.place_id);
      allRestaurants.push({
        ...r,
        first_recommended: week.week_label,
      });
    }
  }
}
---

<Layout title="管理 | Tokyo Gourmet">
  <div class="text-center mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-text">訪問管理</h2>
    <p class="text-text-muted mt-1">「行った」「たぶん行かない」を押したお店は、次の週次から推薦に出なくなります。もう一度押すと解除</p>
    <p class="text-text-light text-xs mt-2">
      記録先は Google Sheets（トップ・アーカイブのボタンと同じ）
    </p>
  </div>

  {allRestaurants.length > 0 ? (
    <div class="bg-surface rounded-xl shadow-md overflow-hidden">
      <!-- Stats -->
      <div class="px-4 py-3 bg-gray-50 border-b border-border flex justify-between items-center text-sm">
        <span class="text-text-muted">
          合計 <span class="font-bold text-text">{allRestaurants.length}</span> 軒
        </span>
        <span class="text-text-muted">
          行った <span class="font-bold text-green-600" id="visited-count">-</span> 軒 /
          たぶん行かない <span class="font-bold text-text" id="skipped-count">-</span> 軒
        </span>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-text-muted text-xs uppercase">
            <tr>
              <th class="px-4 py-3 text-left">状態</th>
              <th class="px-4 py-3 text-left">店名</th>
              <th class="px-4 py-3 text-left hidden md:table-cell">評価</th>
              <th class="px-4 py-3 text-left hidden md:table-cell">予算</th>
              <th class="px-4 py-3 text-left hidden lg:table-cell">初回推薦</th>
              <th class="px-4 py-3 text-left w-24">Maps</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {allRestaurants.map((r: any) => (
              <tr class="hover:bg-gray-50 transition-colors" data-place-id={r.place_id}>
                <td class="px-4 py-3">
                  <StatusButtons placeId={r.place_id} name={r.name} compact />
                </td>
                <td class="px-4 py-3">
                  <div class="font-medium text-text">{r.name}</div>
                  <div class="text-xs text-text-light md:hidden">
                    ★{r.rating} | {r.budget_icon} {r.budget_label}
                  </div>
                </td>
                <td class="px-4 py-3 hidden md:table-cell">
                  <span class="text-star">★</span> {r.rating}
                  <span class="text-text-light text-xs">({r.user_rating_count})</span>
                </td>
                <td class="px-4 py-3 hidden md:table-cell">
                  <span class="text-xs">{r.budget_icon} {r.budget_label}</span>
                </td>
                <td class="px-4 py-3 hidden lg:table-cell text-text-light text-xs">
                  {r.first_recommended}
                </td>
                <td class="px-4 py-3">
                  <a href={r.google_maps_url} target="_blank" rel="noopener noreferrer"
                     class="text-primary hover:text-primary-dark text-xs no-underline">
                    開く →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <div class="text-center py-20">
      <div class="text-6xl mb-4">📋</div>
      <h2 class="text-xl font-bold text-text mb-2">まだデータがありません</h2>
      <p class="text-text-muted">推薦が生成されるとここに表示されます。</p>
    </div>
  )}

  <!-- 件数は状態が読み込まれた・変わったときに数え直す（ボタン本体は StatusButtons） -->
  <script>
    function recount() {
      const boxes = document.querySelectorAll<HTMLElement>('.tg-status');
      let visited = 0;
      let skipped = 0;
      boxes.forEach((b) => {
        if (b.dataset.status === 'visited') visited++;
        if (b.dataset.status === 'skipped') skipped++;
      });
      const v = document.getElementById('visited-count');
      const s = document.getElementById('skipped-count');
      if (v) v.textContent = String(visited);
      if (s) s.textContent = String(skipped);
    }
    document.addEventListener('tg-status-change', recount);
  </script>
</Layout>
